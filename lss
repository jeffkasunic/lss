#!/usr/bin/env python3
# Displays file sequences in a compact representation.

import sys
from pathlib import Path
import logging

from lsslib import (get_padding, is_contiguous, get_step_size, get_missing_frames,
                    get_endframe, get_startframe, find_key)

logger = logging.getLogger("MAIN")
logging.basicConfig(level=logging.INFO, format="[%(levelname)s %(name)s]: %(message)s")


# Get file path from command line
try:
    path = sys.argv[1]
    path += "/"
except IndexError:
    path = "./"
logger.info("Reading files at: " + path)

# Read files into a list and sort
files = []
for file in Path(path).iterdir():
    if not file.name.startswith("."):  # ignore hidden files like ls -1 does
        files.append(file)
files = sorted(files)

# Check if there's files present
if not files:
    logger.error("No files found")
    sys.exit(1)

# Get file name and sequence characteristics first

startframe = get_startframe(files)
endframe = get_endframe(files)
padding = get_padding(files)
is_contiguous = is_contiguous(files)
step_size = get_step_size(files)
if not is_contiguous or step_size != 1:
    missing_frames = get_missing_frames(files)


seq_key = find_key(files)
logger.info(str(seq_key))




