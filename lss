#!/usr/bin/env python3
# Displays file sequences in a compact representation.

import sys
from pathlib import Path
import logging

from lsslib import (get_padding, is_contiguous, is_stepped, get_missing_frames,
                    get_endframe, get_startframe, get_frame_range_total)

logger = logging.getLogger("MAIN")
logging.basicConfig(level=logging.INFO, format="[%(levelname)s %(name)s]: %(message)s")


# Get file path from command line
try:
    path = sys.argv[1]
    path += "/"
except IndexError:
    path = "./"
logger.info("Reading files at: " + path)

# Read files into a list and sort
files = []
for file in Path(path).iterdir():
    if not file.name.startswith("."):  # ignore hidden files like ls -1 does
        files.append(file)
files = sorted(files)

# Check if there's files present
if not files:
    logger.error("No files found")
    sys.exit(1)

# I am assuming multiple sequence types will be located in the same directory, and will need to parse into groups.
#
# Sort file sequences into groups using hash table data structure.
# Uses the variable-size sliding window algorithm to find the grouping key. This will find the
# longest subarray before a different char appears. Only need to compare to next line, since sorted.







# Print file sequences
print(files)






