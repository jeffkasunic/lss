#!/usr/bin/env python3

# Displays file sequences in a compact representation.

# Assumes the filename is formatted: any_text_delimter_or_numer.number.filetension
# Examples:
#   FooA.0000.exr
#   seq3800.0001.exr
#   2000.0220.bty_env_01.0001.exr
#
# This script will work on multiple sequences types in the same directory. For example, all three of the
# above sequences would parse just fine together. Covering the possibility of all sequences living together
# was the reason for thinking about sliding window, longest common prefix algorithms. And the main reason
# I used a hash table / dictionary.
#
# TO FIX: Discontiguous sequences with more than one missing frame only parse the first one. Add a `for` loop.
# TO FIX: Multi-padded sequences in the same directory only prints one of them. Create a temp dictionary to parse while printing.

import sys
import os
from pathlib import Path
import logging
from lsslib import (get_padding, is_contiguous, get_step_size, get_missing_frames, find_key,
                    get_endframe, get_startframe, group_keys, is_mixed_padding)

logger = logging.getLogger("MAIN")
logging.basicConfig(level=logging.INFO, format="[%(levelname)s %(name)s]: %(message)s")


# Get file path from command line
try:
    path = sys.argv[1]
    path += "/"
except IndexError:
    path = "./"
logger.info("Reading files at: " + path)

if not os.path.isdir(path):
    logger.error("No directory found")
    sys.exit("Directory does not exist")
    sys.exit(1)
    
# Read files into a list and sort
files = []
for file in Path(path).iterdir():
    if not file.name.startswith("."):  # ignore hidden files like ls -1 does
        files.append(file)
files = sorted(files)

# Check if there's files present
if not files:
    logger.error("No files found")
    sys.exit(1)

# Read the files and group them into a hash table/dictionary
dictionary = group_keys(files)

# Get the sequence names / keys. FooA, seq100, seq2000, etc
sequences = []
for key in dictionary:
    sequences.append(key)
logger.info(f"The keys are: {sequences}")

# Not in use. Finds the Longest Common Prefix.
lcp = find_key(files)
logger.info(f"Longest Common Prefix: {lcp}")

# Print file sequences in a compact representation.
for sequence in dictionary:
    files_in_sequence = dictionary[sequence]
    
    # Get sequence metadata.
    startframe = get_startframe(dictionary[sequence])
    endframe = get_endframe(dictionary[sequence])
    padding = get_padding(dictionary[sequence])
    mixed_padding = is_mixed_padding(dictionary[sequence])
    step_size = get_step_size(dictionary[sequence])
    contiguous = is_contiguous(dictionary[sequence])
    missing_frames = get_missing_frames(dictionary[sequence])
    
    # Logic statements for printing

    # Get second element in the list. Getting the first element in a zero-padded sequence that started at frame 0 caused a printing error.
    first_file = files_in_sequence[1]
    
    # A sequence of files with a stride length.
    if not contiguous and step_size > 1:
        first_file_metadata = first_file.replace(first_file.split(".")[-2], f"{startframe}-{endframe}x{step_size}#{padding}")
        print(first_file_metadata)
        
    # A discontiguous sequence of files.
    # TO FIX: Needs to be for loop to get all missing frames.
    elif missing_frames:
        first_file_metadata = first_file.replace(first_file.split(".")[-2], f"{startframe}-{missing_frames[0] - 1},{missing_frames[0] + 1}-{endframe}#{padding}")
        print(first_file_metadata)
    
    # Case 04: A multi-padded sequence of files.    
    elif mixed_padding:
        first_file_metadata = first_file.replace(first_file.split(".")[-2], f"{startframe}-{endframe}#{padding}")
        print(first_file_metadata)

    # Case 05: A contiguous sequence of files with 4-padded frames.
    elif padding == 0 and contiguous:
        first_file_metadata = first_file.replace(first_file.split(".")[-2], f"{startframe}-{endframe}#{padding}")
        print(first_file_metadata)
    
    # Default: A contiguous sequence of files with 4-padded frames.
    else:
        first_file_metadata = first_file.replace(first_file.split(".")[-2], f"{startframe}-{endframe}#{padding}")
        print(first_file_metadata)

